# ---- Thesisfic MVP environment ----

# Required: JWT signing secret
JWT_SECRET=change-me-in-production

# Recommended: separate key for encrypting stored AI credentials (falls back to JWT_SECRET)
ENCRYPTION_KEY=

# Optional: persist the in-memory store to a JSON file (local dev only; serverless deployments reset on cold start)
DATA_FILE=

# ---- Institution-level AI provider keys (optional) ----
# When set, students without a connected personal account use these. Without any key the assistant runs in demo mode.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OPENAI_BASE_URL=
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# ---- "Sign in with <provider>" (OAuth 2.0 + PKCE) ----
# Anthropic and OpenAI do not yet expose consumer account sign-in to third-party apps. When a provider
# enables it, fill these in; the connections page then offers the button without code changes.
# ANTHROPIC_OAUTH_CLIENT_ID=
# ANTHROPIC_OAUTH_CLIENT_SECRET=
# ANTHROPIC_OAUTH_AUTHORIZE_URL=
# ANTHROPIC_OAUTH_TOKEN_URL=
# ANTHROPIC_OAUTH_SCOPES=
# OPENAI_OAUTH_CLIENT_ID=
# OPENAI_OAUTH_CLIENT_SECRET=
# OPENAI_OAUTH_AUTHORIZE_URL=
# OPENAI_OAUTH_TOKEN_URL=
# OPENAI_OAUTH_SCOPES=

NODE_ENV=development

# Institution-paid models (configured per university in Admin → AI access & billing).
# The "Thesisfic contract" backend uses the provider keys above; Microsoft Foundry / Azure OpenAI
# resources and the university's own provider keys are entered in the admin UI and stored encrypted.
AZURE_OPENAI_API_VERSION=2024-10-21

# Literature features (OpenAlex, Crossref, Semantic Scholar, Unpaywall).
# OPENALEX_MAILTO is sent as the polite-pool contact; OPENALEX_API_KEY enables semantic search and the $1/day free budget.
OPENALEX_MAILTO=
OPENALEX_API_KEY=
S2_API_KEY=
# Language review: public LanguageTool API by default (20 req/min); point to a self-hosted instance for GDPR.
LANGUAGETOOL_URL=https://api.languagetool.org/v2

# Persistence. Postgres (Neon on Vercel): the whole store is kept as one JSON document and
# survives deploys and cold starts. Without it, DATA_FILE (local JSON) or memory only.
DATABASE_URL=

# Demo accounts. Set both to "off" for a real pilot: the seeded demo logins stop working and the login page hides the shortcuts.
DEMO_ACCOUNTS=
NEXT_PUBLIC_DEMO_ACCOUNTS=
GEMINI_FALLBACK_MODEL=

# Validation questionnaire (/questionnaire). The team signs in at /equipe with this password to read the results
# (/equipe/resultats) and to add questions or phrasings from the form itself. Unset = no team access.
TEAM_PASSWORD=
