# Thesisfy MVP Environment Variables

# JWT Secret for authentication (required for legacy auth, optional with Firebase)
JWT_SECRET=your-secret-key-here-change-in-production

# Anthropic API Key for Claude AI integration (optional - uses simulated responses without it)
ANTHROPIC_API_KEY=

# Claude model to use (optional - defaults to claude-sonnet-4-20250514)
CLAUDE_MODEL=claude-sonnet-4-20250514

# Node environment
NODE_ENV=development

# =============================================================
# Firebase Configuration
# Get these from: https://console.firebase.google.com
# Project Settings > General > Your apps > Web app
# =============================================================

# Client-side Firebase config (NEXT_PUBLIC_ prefix = available in browser)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Server-side Firebase Admin config
# Option A: Service account JSON file (recommended for production)
# Download from: Firebase Console > Project Settings > Service Accounts > Generate New Private Key
# FIREBASE_SERVICE_ACCOUNT_KEY=/path/to/service-account.json

# Option B: Individual credentials (alternative to service account file)
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"
